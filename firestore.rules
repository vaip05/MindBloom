rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validJournal(data) {
      return data.keys().hasOnly(['title', 'body', 'kind', 'prompt', 'moodId', 'createdAt', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 4000
        && data.kind in ['suggestion', 'free', 'prompt']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.kind == 'prompt'
          ? data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 200
          : !data.keys().hasAny(['prompt']))
        && (!data.keys().hasAny(['moodId'])
          || (data.kind == 'suggestion'
            && data.moodId in ['great', 'good', 'okay', 'not-great', 'tough']));
    }

    function validUserProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'email', 'displayName', 'avatarEmoji', 'bio',
          'createdAt', 'updatedAt', 'reminderDefaults'
        ])
        && data.uid == userId
        && data.email is string
        && data.displayName is string
        && data.displayName.size() <= 100
        && (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 16))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 160))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('reminderDefaults' in data) || validReminderDefaults(data.reminderDefaults));
    }

    function validReminderDefaults(data) {
      return data is map
        && data.keys().hasOnly(['enabled', 'date', 'time', 'message', 'updatedAt'])
        && data.enabled is bool
        && data.time is string
        && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.message is string
        && data.message.size() <= 180
        && (!('date' in data) || data.date is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validReminder(data, userId) {
      return data.keys().hasOnly(['uid', 'enabled', 'date', 'time', 'message', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.enabled is bool
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 180
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validMoodEntry(data) {
      return data.keys().hasOnly([
          'moodId', 'moodValue', 'stressLevel', 'note', 'createdAt', 'localDate'
        ])
        && data.keys().hasAll([
          'moodId', 'moodValue', 'stressLevel', 'note', 'createdAt', 'localDate'
        ])
        && data.moodId in ['great', 'good', 'okay', 'not-great', 'tough']
        && data.moodValue is int
        && data.moodValue >= 1 && data.moodValue <= 5
        && data.stressLevel is int
        && data.stressLevel >= 1 && data.stressLevel <= 5
        && data.note is string
        && data.note.size() <= 240
        && data.createdAt is timestamp
        && data.localDate is string;
    }

    function validBreathingSession(data) {
      return data.keys().hasOnly([
          'exerciseType', 'durationSeconds', 'cyclesCompleted', 'completed',
          'completedAt', 'createdAt', 'goodSession', 'updatedAt'
        ])
        && data.keys().hasAll([
          'exerciseType', 'durationSeconds', 'cyclesCompleted', 'completed',
          'completedAt', 'createdAt'
        ])
        && data.exerciseType is string
        && data.exerciseType.size() <= 80
        && data.durationSeconds is int
        && data.durationSeconds >= 0 && data.durationSeconds <= 3600
        && data.cyclesCompleted is int
        && data.cyclesCompleted >= 0 && data.cyclesCompleted <= 100
        && data.completed is bool
        && data.completedAt is timestamp
        && data.createdAt is timestamp
        && (!('goodSession' in data) || data.goodSession is bool)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validSuggestions(userId, data) {
      return data.keys().hasOnly([
          'uid', 'suggestions', 'page', 'averages', 'dailyMoodAverage',
          'dailyStressAverage', 'weeklyMoodAverage', 'weeklyStressAverage',
          'basedOnMood', 'basedOnStress', 'updatedAt'
        ])
        && data.uid == userId
        && data.suggestions is list
        && (!('page' in data) || (data.page is int && data.page >= 0))
        && (!('averages' in data) || data.averages is map)
        && (!('dailyMoodAverage' in data) || data.dailyMoodAverage == null
          || ((data.dailyMoodAverage is int || data.dailyMoodAverage is float) && data.dailyMoodAverage >= 1 && data.dailyMoodAverage <= 5))
        && (!('dailyStressAverage' in data) || data.dailyStressAverage == null
          || ((data.dailyStressAverage is int || data.dailyStressAverage is float) && data.dailyStressAverage >= 1 && data.dailyStressAverage <= 5))
        && (!('weeklyMoodAverage' in data) || data.weeklyMoodAverage == null
          || ((data.weeklyMoodAverage is int || data.weeklyMoodAverage is float) && data.weeklyMoodAverage >= 1 && data.weeklyMoodAverage <= 5))
        && (!('weeklyStressAverage' in data) || data.weeklyStressAverage == null
          || ((data.weeklyStressAverage is int || data.weeklyStressAverage is float) && data.weeklyStressAverage >= 1 && data.weeklyStressAverage <= 5))
        && (!('basedOnMood' in data) || data.basedOnMood == null
          || data.basedOnMood in ['great', 'good', 'okay', 'not-great', 'tough'])
        && (!('basedOnStress' in data) || data.basedOnStress == null
          || (data.basedOnStress is int && data.basedOnStress >= 1 && data.basedOnStress <= 5))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserProfile(userId);
      allow delete: if isOwner(userId);

      match /moodEntries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validMoodEntry(request.resource.data);
        allow update: if false;
      }

      match /breathingSessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validBreathingSession(request.resource.data);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goodSession', 'updatedAt'])
          && validBreathingSession(request.resource.data);
      }

      match /reminders/{reminderId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validReminder(request.resource.data, userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled', 'date', 'time', 'message', 'updatedAt'])
          && validReminder(request.resource.data, userId);
      }

      match /wellnessSuggestions/{suggestionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSuggestions(userId, request.resource.data);
      }

      match /journalEntries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validJournal(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
